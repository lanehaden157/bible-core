# Store and check out text as LF on every machine (Windows included), so
# diffs between books and the template compare content, not line endings.
* text=auto eol=lf

# Binary: never convert, never diff as text
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary
*.gz    binary
